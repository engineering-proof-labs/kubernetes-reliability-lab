{
  "name": "kubernetes-reliability-lab",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "start": "node dist/main.js",
    "typecheck": "tsc --noEmit -p tsconfig.test.json",
    "lint": "eslint .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "build": "tsc -p tsconfig.json",
    "image:build": "docker build --tag kubernetes-reliability-lab:local .",
    "lab:up": "node scripts/lab.mjs up",
    "lab:status": "node scripts/lab.mjs status",
    "lab:check": "node scripts/lab.mjs check",
    "lab:logs": "node scripts/lab.mjs logs",
    "lab:down": "node scripts/lab.mjs down",
    "experiment:traffic": "node scripts/traffic.mjs",
    "experiment:replace-pod": "node scripts/replace-pod.mjs",
    "experiment:probes": "node scripts/probes.mjs",
    "experiment:rollout": "node scripts/rollout.mjs",
    "test:cluster": "node scripts/test-cluster.mjs",
    "verify": "npm run typecheck && npm run lint && npm run format:check && npm test && npm run build"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "24.19.2",
    "eslint": "10.15.0",
    "globals": "17.14.0",
    "prettier": "3.10.1",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "typescript-eslint": "8.73.0",
    "vitest": "5.1.1"
  }
}
